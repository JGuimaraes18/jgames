{
  "name": "jgames",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Jogos educativos para todas as idades",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "João Guimarães",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.jgames.jogoseducativos",
    "productName": "JGames",
    "directories": {
      "output": "build"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json",
      "css/**/*",
      "js/**/*",
      "games/**/*",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "icon.ico",
      "category": "Education",
      "maintainer": "João Guimarães"
    }
  }
}
